DATABASE_URL=sqlite:///./school.db
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
FINANCE_TRANSFER_INSTRUCTIONS=""
FINANCE_SIMULATOR_ENABLED=true
# Correo (M6). "console" solo escribe en el log; "smtp" envía con cualquier proveedor.
EMAIL_BACKEND=console
EMAIL_FROM="Nexo <no-reply@localhost>"
APP_URL=http://localhost:5173
# Dominio base para los subdominios de las instituciones (Fase 4 B), p. ej. nexo.do. Vacío: acceso con el código de la institución.
TENANT_BASE_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Límites de peticiones en subidas, exportaciones e importaciones (Fase 4 C).
RATE_LIMITS_ENABLED=true

# Archivos subidos (Fase 4 C). "local" guarda en STORAGE_DIR; "s3" usa cualquier
# servicio compatible con S3 (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Seguimiento de errores (Fase 4 C): Sentry o GlitchTip. Vacío: desactivado.
# Nunca se envían cuerpos, cabeceras, cookies, correos ni tokens.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend (al construir): VITE_SENTRY_DSN y VITE_RELEASE.

# Planes y suscripciones (Fase 4 D): días de prueba de una institución nueva.
BILLING_TRIAL_DAYS=30
